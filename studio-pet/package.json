{
  "name": "agent-flow-studio-pet",
  "version": "0.2.4",
  "description": "AgentFlow desktop pet. Shell from pixelpets (MIT) — a pixel-art cat overlay, stripped to cat-only + AgentFlow status bridge.",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "shot": "electron . --shot --state=idle --at=800",
    "test:pet-size": "node scripts/pet-size-regression.mjs",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "org.agentflow.studio-pet",
    "productName": "AgentFlow Pet",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "run-pet.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../studio",
        "to": "studio",
        "filter": ["**/*"]
      },
      {
        "from": "../lib",
        "to": "lib",
        "filter": ["**/*"]
      }
    ],
    "mac": { "target": ["zip", "dmg"] },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"] }
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "^26.0.12"
  }
}
