{
  "name": "agent-flow",
  "version": "0.2.3",
  "description": "Markdown-first step workflows with deterministic Boolean gates for any coding agent (ZCode / Claude Code / Codex CLI).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanghelyu/agent-flow.git"
  },
  "homepage": "https://github.com/kanghelyu/agent-flow#readme",
  "bugs": "https://github.com/kanghelyu/agent-flow/issues",
  "keywords": [
    "agent",
    "workflow",
    "markdown",
    "cli",
    "coding-agent",
    "claude-code",
    "codex",
    "zcode",
    "logic-gates",
    "visualization",
    "desktop-pet"
  ],
  "bin": {
    "af": "bin/af.mjs"
  },
  "scripts": {
    "check": "node --check bin/af.mjs && node --check studio/server.mjs && npm --prefix studio-pet run check",
    "test": "node --test test/cli.test.mjs test/studio.test.mjs",
    "test:pet-size": "npm --prefix studio-pet run test:pet-size"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "studio",
    "studio-pet",
    "examples",
    "install.sh",
    "install.ps1",
    "README.md",
    "INSTALL.md",
    "README.zh-CN.md",
    "RUNTIME.md",
    "LICENSE",
    "ATTRIBUTION.md",
    ".zcode-plugin"
  ]
}
